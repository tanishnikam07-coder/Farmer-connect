<!DOCTYPE html>
<html>

<head>
    <title>Farmer Connect Anime</title>

    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI';
            background: linear-gradient(135deg, #0f2027, #2c5364);
            color: white;
            text-align: center;
        }

        h1 {
            padding: 20px;
            font-size: 35px;
            background: linear-gradient(to right, #00ffcc, #00ccff);
            -webkit-background-clip: text;
            color: transparent;
        }

        /* Road */
        .road {
            width: 100%;
            height: 180px;
            background: #222;
            position: relative;
            overflow: hidden;
            box-shadow: 0 0 20px #00ccff;
        }

        /* Tractor */
        .tractor {
            position: absolute;
            bottom: 20px;
            left: -150px;
            font-size: 70px;
            animation: move 4s linear infinite;
            filter: drop-shadow(0 0 10px #00ffcc);
        }

        @keyframes move {
            0% { left: -150px; }
            100% { left: 100%; }
        }

        .box {
            margin-top: 30px;
        }

        input {
            padding: 12px;
            border-radius: 10px;
            border: none;
            width: 220px;
            font-size: 16px;
            outline: none;
        }

        button {
            padding: 12px 25px;
            border-radius: 20px;
            border: none;
            background: linear-gradient(45
